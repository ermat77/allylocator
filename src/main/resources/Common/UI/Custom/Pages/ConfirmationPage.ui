$C = "../Common.ui";

Group {
  Anchor: (Width: 400, Height: 180);
  Background: #141c26(0.98);
  LayoutMode: Top;
  Padding: (Full: 20);

  Label #titleLabel {
    Text: "";
    Anchor: (Height: 28);
    Style: (
      FontSize: 18,
      TextColor: #ffffff,
      RenderBold: true
    );
  }

  Group { Anchor: (Height: 12); }

  Label #messageLabel {
    Text: "";
    Anchor: (Height: 48);
    Style: (
      FontSize: 14,
      TextColor: #96a9be
    );
  }

  Group { FlexWeight: 1; }

  Group {
    LayoutMode: Right;
    Anchor: (Height: 40);

    $C.@CancelTextButton #cancelButton {
      Text: "Cancel";
      Anchor: (Width: 90, Height: 36);
    }

    Group { Anchor: (Width: 12); }

    $C.@TextButton #confirmButton {
      Text: "Confirm";
      Anchor: (Width: 90, Height: 36);
    }
  }
}
