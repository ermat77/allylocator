$C = "../Common.ui";

$C.@PageOverlay {

  $C.@DecoratedContainer {
    Anchor: (Width: 600, Height: 500);

    #Title {
      Group {
        $C.@Title #TitleText {
          @Text = "Faction Information";
        }
      }
    }

    #Content {
      LayoutMode: Top;

      // Faction Info Panel (shown when player has a faction)
      Group #factionInfoPanel {
        LayoutMode: Top;
        Padding: (Left: 20, Right: 20, Top: 20, Bottom: 20);
        Visible: false;

        // Basic Info Section (visible for all roles)
        Group #basicInfoSection {
          LayoutMode: Top;
          Anchor: (Bottom: 10);

          Label #factionNameLabel {
            Text: "Faction Name:";
            Style: (
              FontSize: 18,
              TextColor: #CCCCCC
            );
            Anchor: (Bottom: 5);
          }

          Label #factionName {
            Text: "Loading...";
            Style: (
              FontSize: 20,
              TextColor: #FFFFFF,
              RenderBold: true
            );
            Anchor: (Bottom: 10);
          }

          Label #memberCountLabel {
            Text: "Members:";
            Style: (
              FontSize: 18,
              TextColor: #CCCCCC
            );
            Anchor: (Bottom: 5);
          }

          Label #memberCount {
            Text: "0";
            Style: (
              FontSize: 20,
              TextColor: #FFFFFF
            );
            Anchor: (Bottom: 10);
          }
        }

        // Owner-specific action buttons
        Group #ownerButtons {
          LayoutMode: Top;
          Anchor: (Bottom: 10);
          Visible: false;
        }

        // General/Member view (basic info with member list)
        Group #memberView {
          LayoutMode: Top;
          Anchor: (Bottom: 10);
          Visible: false;

          Label #membersListLabelMember {
            Text: "Faction Members:";
            Style: (
              FontSize: 16,
              TextColor: #CCCCCC,
              RenderBold: true
            );
            Anchor: (Bottom: 10);
          }

          // Scrollable member list container
          Group #membersListContainerMember {
            LayoutMode: Top;
            FlexWeight: 1;
            Anchor: (Bottom: 10);

            Label #membersListPlaceholderMember {
              Text: "Loading members...";
              Style: (
                FontSize: 14,
                TextColor: #AAAAAA
              );
            }
          }
        }
      }

      // Create Faction Panel (shown when player doesn't have a faction)
      Group #createFactionPanel {
        LayoutMode: Top;
        Padding: (Left: 20, Right: 20, Top: 20, Bottom: 20);
        Visible: false;

        Label #createLabel {
          Text: "You are not in a faction.";
          Style: (
            FontSize: 18,
            TextColor: #CCCCCC,
            HorizontalAlignment: Center
          );
          Anchor: (Bottom: 10);
        }

        Label #createSubLabel {
          Text: "Create a new faction:";
          Style: (
            FontSize: 16,
            TextColor: #AAAAAA,
            HorizontalAlignment: Center
          );
          Anchor: (Bottom: 10);
        }

        Label #factionNameInputLabel {
          Text: "Faction Name:";
          Style: (
            FontSize: 16,
            TextColor: #CCCCCC
          );
          Anchor: (Bottom: 5);
        }

        $C.@TextField #factionNameInput {
          Anchor: (Bottom: 10, Height: 40);
          Style: (
            FontSize: 14,
            TextColor: #ffffff(0.9)
          );
          FlexWeight: 1;
        }

        $C.@TextButton #createButton {
          Text: "Create Faction";
          Anchor: (Bottom: 10);
          Style: (
            Default: (
              Background: #4CAF50(0.8),
              LabelStyle: (
                FontSize: 18,
                TextColor: #FFFFFF,
                HorizontalAlignment: Center
              )
            )
          );
        }
      }

      Label { FlexWeight: 1; }

      // Action buttons at the bottom (beautiful design)
      Group #actionButtons {
        LayoutMode: Right;
        Anchor: (Bottom: 15);
        Padding: (Left: 10, Right: 10, Top: 10, Bottom: 10);
        Visible: false; // Controlled by Java - only visible when player has faction

        $C.@TextButton #settingsButton {
          Text: "⚙ Settings";
          Padding: (Left: 20, Right: 20, Top: 12, Bottom: 12);
          Anchor: (Right: 10);
          Visible: false; // Controlled by Java - only visible for owners
          Background: (Color: #4CAF50(0.9));
          Style: TextButtonStyle(
            Default: (
              LabelStyle: (
                FontSize: 16,
                TextColor: #FFFFFF,
                HorizontalAlignment: Center,
                RenderBold: true
              )
            ),
            Hovered: (
              Background: (Color: #45A049(0.95)),
              LabelStyle: (
                FontSize: 16,
                TextColor: #FFFFFF,
                HorizontalAlignment: Center,
                RenderBold: true
              )
            ),
            Sounds: $C.@ButtonSounds
          );
        }

        $C.@TextButton #membersButton {
          Text: "👥 Members";
          Padding: (Left: 20, Right: 20, Top: 12, Bottom: 12);
          Anchor: (Right: 10);
          Visible: false; // Controlled by Java - visible when player has faction
          Background: (Color: #2196F3(0.9));
          Style: TextButtonStyle(
            Default: (
              LabelStyle: (
                FontSize: 16,
                TextColor: #FFFFFF,
                HorizontalAlignment: Center,
                RenderBold: true
              )
            ),
            Hovered: (
              Background: (Color: #1976D2(0.95)),
              LabelStyle: (
                FontSize: 16,
                TextColor: #FFFFFF,
                HorizontalAlignment: Center,
                RenderBold: true
              )
            ),
            Sounds: $C.@ButtonSounds
          );
        }
      }

      // Close button (always visible)
      Group #InteractionButtons {
        LayoutMode: Right;
        Anchor: (Bottom: 10);

        $C.@CancelTextButton #closeButton {
          Text: "Close";
          Padding: (Left: 12, Right: 12, Top: 6, Bottom: 6);
          Anchor: (Right: 10);
        }
      }
    }
  }
}

$C.@BackButton {}
