$C = "../Common.ui";

Group {
  LayoutMode: Right;
  Anchor: (Height: 32);

  Label #AllyLabel {
    Text: "";
    FlexWeight: 1;
    Anchor: (Vertical: 0);
    Style: (FontSize: 14, TextColor: #ffffff, VerticalAlignment: Center);
  }

  $C.@TextButton #MembersButton {
    Text: "Members";
    Anchor: (Width: 220, Height: 28, Vertical: 0);
  }

  Group { Anchor: (Width: 8); }

  $C.@TextButton #SettingsButton {
    Text: "Settings";
    Anchor: (Width: 200, Height: 28, Vertical: 0);
  }

  Group { Anchor: (Width: 8); }

  $C.@CancelTextButton #RemoveButton {
    Text: "Remove";
    Anchor: (Width: 120, Height: 28, Vertical: 0);
  }
}
