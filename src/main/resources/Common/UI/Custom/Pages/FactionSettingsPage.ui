$C = "../Common.ui";

Group {
  Anchor: (Width: 600, Height: 500);
  Background: #141c26(0.98);
  LayoutMode: Top;
  Padding: (Full: 20);

  Label #settingsTitleLabel {
    Text: "Faction Settings";
    Anchor: (Height: 45);
    Style: (
      FontSize: 26,
      TextColor: #ffffff,
      HorizontalAlignment: Center,
      RenderBold: true
    );
  }

  Group {
    Anchor: (Height: 1);
    Background: #2b3542;
  }

  Group { Anchor: (Height: 16); }

  Group {
    LayoutMode: Top;
    FlexWeight: 1;

    Label #renameLabel {
      Text: "Rename Faction:";
      Style: (
        FontSize: 16,
        TextColor: #CCCCCC
      );
      Anchor: (Height: 30);
    }

    Group {
      LayoutMode: Right;
      Anchor: (Height: 40);

      $C.@TextField #RenameInput {
        Anchor: (Height: 35);
        FlexWeight: 1;
      }

      Group { Anchor: (Width: 12); }

      $C.@TextButton #renameButton {
        Text: "RENAME";
        Padding: (Left: 12, Right: 12, Top: 6, Bottom: 6);
        Anchor: (Width: 120, Height: 35);
        Background: (Color: #4870ddff);
      }
    }

    Group { Anchor: (Height: 20); }

    Label #colorLabel {
      Text: "Faction Color:";
      Style: (
        FontSize: 16,
        TextColor: #CCCCCC
      );
      Anchor: (Height: 30);
    }

    ColorPicker #ColorPicker {
      Anchor: (Height: 200);
      DisplayTextField: true;
      Style: $C.@DefaultColorPickerStyle;
    }

    Group { FlexWeight: 1; }
  }

  Group {
    Anchor: (Height: 1);
    Background: #2b3542(0.5);
  }

  Group { Anchor: (Height: 16); }

  Group #ActionButtons {
    LayoutMode: Right;
    Anchor: (Height: 44);

    $C.@TextButton #backButton {
      Text: "BACK";
      Anchor: (Width: 110, Height: 40);
      Background: (Color: #4870ddff);
    }

    Group { FlexWeight: 1; }

    $C.@CancelTextButton #disbandButton {
      Text: "DISBAND";
      Anchor: (Width: 150, Height: 40);
      Visible: false;
      Background: (Color: #ff0000ff);
    }

    Group { Anchor: (Width: 16); }

    $C.@CancelTextButton #closeButton {
      Text: "CLOSE";
      Anchor: (Width: 110, Height: 40);
    }
  }
}
