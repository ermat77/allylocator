$C = "../../Common.ui";

Group {
  LayoutMode: Right;
  Anchor: (Height: 32);

  Label #EnemyLabel {
    Text: "";
    FlexWeight: 1;
    Anchor: (Vertical: 0);
    Style: (FontSize: 14, TextColor: #ffffff, VerticalAlignment: Center);
  }

  $C.@TextButton #MembersButton {
    Text: "Members";
    Anchor: (Width: 130, Height: 28, Vertical: 0);
  }

  Group { Anchor: (Width: 8); }

  $C.@TextButton #RemoveButton {
    Text: "Remove";
    Visible: false;
    Anchor: (Width: 80, Height: 28, Vertical: 0);
  }
}
