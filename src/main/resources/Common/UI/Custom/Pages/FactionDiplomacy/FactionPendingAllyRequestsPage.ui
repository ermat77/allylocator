$C = "../../Common.ui";

Group {
  Anchor: (Width: 680, Height: 520);
  Background: #141c26(0.98);
  LayoutMode: Top;
  Padding: (Full: 20);

  Label #pendingAllyTitleLabel {
    Text: "Pending ally requests";
    Anchor: (Height: 45);
    Style: (
      FontSize: 26,
      TextColor: #ffffff,
      HorizontalAlignment: Center,
      RenderBold: true
    );
  }

  Group {
    Anchor: (Height: 1);
    Background: #2b3542;
  }

  Group { Anchor: (Height: 16); }

  Label #noPendingRequestsLabel {
    Text: "No pending requests";
    Style: (FontSize: 14, TextColor: #96a9be);
    Visible: false;
    Anchor: (Height: 28);
  }

  Group #PendingRequestsList {
    LayoutMode: TopScrolling;
    ScrollbarStyle: $C.@DefaultScrollbarStyle;
    FlexWeight: 1;
  }

  Group {
    Anchor: (Height: 1);
    Background: #2b3542(0.5);
  }

  Group { Anchor: (Height: 16); }

  Group #ActionButtons {
    LayoutMode: Right;
    Anchor: (Height: 44);

    $C.@TextButton #backButton {
      Text: "BACK";
      Anchor: (Width: 120, Height: 40);
    }

    Group { FlexWeight: 1; }

    $C.@CancelTextButton #closeButton {
      Text: "CLOSE";
      Anchor: (Width: 110, Height: 40);
    }
  }
}
