$C = "../../Common.ui";

Group {
  LayoutMode: Right;
  Anchor: (Height: 44);
  Padding: (Left: 12, Right: 12, Top: 8, Bottom: 8);
  Background: #1e2832(0.6);

  Group {
    LayoutMode: Right;
    FlexWeight: 1;
    Anchor: (Vertical: 0);

    Label #RankLabel {
      Text: "";
      Style: (
        FontSize: 14,
        TextColor: #96a9be
      );
      Anchor: (Width: 40, Height: 22);
    }
    Label #FactionNameLabel {
      Text: "";
      FlexWeight: 1;
      Style: (
        FontSize: 16,
        TextColor: #ffffff
      );
      Anchor: (Height: 22);
    }
    Label #PointsLabel {
      Text: "";
      Style: (
        FontSize: 14,
        TextColor: #96a9be
      );
      Anchor: (Width: 110, Height: 22);
    }
  }

  Group { Anchor: (Width: 12); }
}
