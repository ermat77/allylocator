$Common = "../../Common.ui";

Group {
  Anchor: (Width: 700, Height: 600);
  Background: #141c26(0.98);
  LayoutMode: Top;
  Padding: (Full: 20);

  Group {
    LayoutMode: Right;
    Anchor: (Height: 44);

    $Common.@TextButton #leaderboardButton {
      Text: "Classement";
      Anchor: (Width: 140, Height: 40);
      Visible: false;
    }

    Group { FlexWeight: 1; }

    $Common.@TextButton #prismButton {
      Text: "Prism";
      Anchor: (Width: 120, Height: 40);
      Visible: false;
    }
  }

  Label #factionTitleLabel {
    Text: "Faction";
    Anchor: (Height: 45);
    Style: (
      FontSize: 26,
      TextColor: #ffffff,
      HorizontalAlignment: Center,
      RenderBold: true
    );
  }

  Group {
    Anchor: (Height: 1);
    Background: #2b3542;
  }

  Group { Anchor: (Height: 16); }

  Group {
    LayoutMode: Top;
    FlexWeight: 1;

    Group #factionInfoSection {
      LayoutMode: Top;
      Visible: true;

      Label #factionNameLabel {
        Text: "";
        Style: (
          FontSize: 24,
          TextColor: #ffffff,
          RenderBold: true
        );
        Anchor: (Height: 50);
      }

      Label #memberCountLabel {
        Text: "";
        Style: (
          FontSize: 16,
          TextColor: #96a9be
        );
        Anchor: (Height: 30);
      }

      Group { Anchor: (Height: 10); }

      // Horizontal container for members and pending invites panels
      Group {
        LayoutMode: Right;
        FlexWeight: 1;

        // Members panel (left, 2/3 width)
        Group {
          LayoutMode: Top;
          FlexWeight: 2;

          Label #membersHeaderLabel {
            Text: "Members:";
            Style: (
              FontSize: 18,
              TextColor: #96a9be,
              RenderBold: true
            );
            Anchor: (Height: 30);
          }

          Label #noMembersLabel {
            Text: "No members";
            Style: (
              FontSize: 14,
              TextColor: #96a9be
            );
            Visible: false;
            Anchor: (Height: 30);
          }

          // Member list container - dynamically populated via Java
          Group #MemberList {
            LayoutMode: TopScrolling;
            ScrollbarStyle: $Common.@DefaultScrollbarStyle;
            FlexWeight: 1;
          }
        }

        Group { Anchor: (Width: 16); }

        // Pending invites panel (right, 1/3 width, owner only)
        Group #pendingInvitesSection {
          LayoutMode: Top;
          FlexWeight: 1;
          Visible: false;

          Label #pendingInvitesHeaderLabel {
            Text: "Pending Invites:";
            Style: (
              FontSize: 18,
              TextColor: #96a9be,
              RenderBold: true
            );
            Anchor: (Height: 30);
          }

          Label #noPendingInvitesLabel {
            Text: "No pending invites";
            Style: (
              FontSize: 14,
              TextColor: #96a9be
            );
            Visible: false;
            Anchor: (Height: 30);
          }

          Group #PendingInvitesList {
            LayoutMode: TopScrolling;
            ScrollbarStyle: $Common.@DefaultScrollbarStyle;
            FlexWeight: 1;
          }
        }
      }
    }

    // Create faction section (shown when player has no faction and has permission)
    Group #createFactionSection {
      LayoutMode: Top;
      Visible: false;

      Label #instructionsLabel {
        Text: "Enter a name for your new faction:";
        Style: (
          FontSize: 16,
          TextColor: #96a9be
        );
        Anchor: (Height: 30);
      }

      Group { Anchor: (Height: 12); }

      Group {
        LayoutMode: Right;
        Anchor: (Height: 44);
        Padding: (Full: 8);

        $Common.@TextField #FactionNameInput {
          Anchor: (Height: 44);
          FlexWeight: 1;
          PlaceholderText: "Enter faction name...";
        }

        Group { Anchor: (Width: 12); }

        $Common.@TextButton #createFactionButtonInSection {
          Text: "CREATE FACTION";
          Anchor: (Width: 200, Height: 44);
        }
      }

      Group { FlexWeight: 1; }
    }

    // Pending invites section (shown below create form when player has no faction but has invites)
    Group #pendingInvitesPageSection {
      LayoutMode: Top;
      Visible: false;

      Label #headerLabel {
        Text: "You have been invited to join factions:";
        Style: (
          FontSize: 16,
          TextColor: #96a9be
        );
        Anchor: (Height: 30);
      }

      Group { Anchor: (Height: 10); }

      Group #InvitesList {
        LayoutMode: Top;
        FlexWeight: 1;

        Label #noInvitesLabel {
          Text: "No pending invites";
          Style: (
            FontSize: 14,
            TextColor: #96a9be
          );
          Visible: false;
        }
      }

      Group { FlexWeight: 1; }
    }

    // No permission section (shown when player has no faction, no invites, and no permission)
    Group #noPermissionSection {
      LayoutMode: Top;
      Visible: false;

      Label #noPermissionLabel {
        Text: "You don't have permission to create or join a faction";
        Style: (
          FontSize: 16,
          TextColor: #ff6b6b,
          HorizontalAlignment: Center
        );
        Anchor: (Height: 30);
      }

      Group { FlexWeight: 1; }
    }
  }

  Group {
    Anchor: (Height: 1);
    Background: #2b3542(0.5);
  }

  Group { Anchor: (Height: 16); }

  Group #ActionButtons {
    LayoutMode: Right;
    Anchor: (Height: 44);

    $Common.@TextButton #diplomacyButton {
      Text: "DIPLOMACY";
      Anchor: (Width: 160, Height: 40);
      Visible: false;
    }

    Group { Anchor: (Width: 16); }

    $Common.@TextButton #claimButton {
      Text: "CLAIM";
      Anchor: (Width: 140, Height: 40);
      Visible: false;
    }

    Group { Anchor: (Width: 16); }

    $Common.@TextButton #createFactionButton {
      Text: "CREATE FACTION";
      Anchor: (Width: 150, Height: 40);
      Visible: false;
    }

    Group { FlexWeight: 1; }

    $Common.@TextButton #settingsButton {
      Text: "SETTINGS";
      Anchor: (Width: 140, Height: 40);
      Visible: false;
    }

    Group { Anchor: (Width: 16); }

    $Common.@CancelTextButton #closeButton {
      Text: "CLOSE";
      Anchor: (Width: 110, Height: 40);
    }
  }
}
