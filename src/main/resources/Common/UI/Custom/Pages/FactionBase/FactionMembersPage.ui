$C = "../../Common.ui";

$C.@PageOverlay {

  $C.@DecoratedContainer {
    Anchor: (Width: 600, Height: 500);

    #Title {
      Group {
        $C.@Title #TitleText {
          @Text = "Faction Members";
        }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Left: 20, Right: 20, Top: 20, Bottom: 20);

      Label #membersListLabel {
        Text: "Faction Members:";
        Style: (
          FontSize: 18,
          TextColor: #CCCCCC,
          RenderBold: true
        );
        Anchor: (Bottom: 10);
      }

      // Scrollable member list container
      Group #membersListContainer {
        LayoutMode: Top;
        FlexWeight: 1;
        Anchor: (Bottom: 10);

        // Member entries will be dynamically added via Java
        Label #membersListPlaceholder {
          Text: "Loading members...";
          Style: (
            FontSize: 14,
            TextColor: #AAAAAA
          );
        }
      }

      // Back and Close buttons
      Group #InteractionButtons {
        LayoutMode: Right;
        Anchor: (Bottom: 10);

        $C.@TextButton #backButton {
          Text: "BACK";
          Anchor: (Width: 120, Height: 40);
        }

        Group { Anchor: (Width: 12); }

        $C.@CancelTextButton #closeButton {
          Text: "Close";
          Padding: (Left: 12, Right: 12, Top: 6, Bottom: 6);
          Anchor: (Right: 10);
        }
      }
    }
  }
}
