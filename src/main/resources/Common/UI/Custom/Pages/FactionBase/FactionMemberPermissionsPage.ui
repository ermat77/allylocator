$C = "../../Common.ui";

Group {
  Anchor: (Width: 520, Height: 520);
  Background: #141c26(0.98);
  LayoutMode: Top;
  Padding: (Full: 20);

  Label #TitleLabel {
    Text: "Member Permissions";
    Anchor: (Height: 45);
    Style: (
      FontSize: 26,
      TextColor: #ffffff,
      HorizontalAlignment: Center,
      RenderBold: true
    );
  }

  Group {
    Anchor: (Height: 1);
    Background: #2b3542;
  }

  Group { Anchor: (Height: 16); }

  Label #instructionsLabel {
    Text: "Select permissions to grant to this member:";
    Style: (
      FontSize: 16,
      TextColor: #CCCCCC
    );
    Anchor: (Bottom: 10);
  }

  Group #CheckboxList {
    LayoutMode: TopScrolling;
    ScrollbarStyle: $C.@DefaultScrollbarStyle;
    FlexWeight: 1;

    $C.@CheckBoxWithLabel #Rename {
      @Text = "Rename Faction";
      Padding: (Bottom: 8);
    }

    $C.@CheckBoxWithLabel #Color {
      @Text = "Change Color";
      Padding: (Bottom: 8);
    }

    $C.@CheckBoxWithLabel #Invite {
      @Text = "Invite Members";
      Padding: (Bottom: 8);
    }

    $C.@CheckBoxWithLabel #Allies {
      @Text = "Manage Allies";
      Padding: (Bottom: 8);
    }

    $C.@CheckBoxWithLabel #Kick {
      @Text = "Kick Members";
      Padding: (Bottom: 8);
    }

    $C.@CheckBoxWithLabel #Enemies {
      @Text = "Manage Enemies";
      Padding: (Bottom: 8);
    }

    $C.@CheckBoxWithLabel #OpenChest {
      @Text = "Open Chest";
      Padding: (Bottom: 8);
    }

    $C.@CheckBoxWithLabel #OpenDoor {
      @Text = "Open Door";
      Padding: (Bottom: 8);
    }

    $C.@CheckBoxWithLabel #OpenBench {
      @Text = "Use Bench";
      Padding: (Bottom: 8);
    }

    $C.@CheckBoxWithLabel #UseChair {
      @Text = "Use Chair";
      Padding: (Bottom: 8);
    }

    $C.@CheckBoxWithLabel #UsePortal {
      @Text = "Use Portal";
      Padding: (Bottom: 8);
    }

    $C.@CheckBoxWithLabel #PlaceBlock {
      @Text = "Place Block";
      Padding: (Bottom: 8);
    }

    $C.@CheckBoxWithLabel #BreakBlock {
      @Text = "Break Block";
      Padding: (Bottom: 8);
    }

    $C.@CheckBoxWithLabel #SetHome {
      @Text = "Set Faction Home";
      Padding: (Bottom: 8);
    }

    $C.@CheckBoxWithLabel #Home {
      @Text = "Use Faction Home";
      Padding: (Bottom: 8);
    }
  }

  Group {
    Anchor: (Height: 1);
    Background: #2b3542(0.5);
  }

  Group { Anchor: (Height: 16); }

  Group #ActionButtons {
    LayoutMode: Right;
    Anchor: (Height: 44);

    $C.@TextButton #backButton {
      Text: "BACK";
      Anchor: (Width: 120, Height: 40);
      Background: (Color: #4870ddff);
    }
  }
}
