$C = "../../Common.ui";

Group {
  LayoutMode: Right;
  Anchor: (Height: 30);

  Label #RowLabel {
    Text: "";
    FlexWeight: 1;
    Anchor: (Vertical: 0);
    Style: (VerticalAlignment: Center);
  }

  $C.@TextButton #AcceptButton {
    Text: "Accept";
    Anchor: (Vertical: 0);
  }

  Group { Anchor: (Width: 8); }

  $C.@CancelTextButton #RefuseButton {
    Text: "Decline";
    Anchor: (Vertical: 0);
  }
}
