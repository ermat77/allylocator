$C = "../Common.ui";

$C.@PageOverlay {

  $C.@DecoratedContainer {
    Anchor: (Width: 600, Height: 500);

    #Title {
      Group {
        $C.@Title #TitleText {
          @Text = "Member Permissions";
        }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Left: 20, Right: 20, Top: 20, Bottom: 20);

      Label #instructionsLabel {
        Text: "Select permissions to grant to this member:";
        Style: (
          FontSize: 16,
          TextColor: #CCCCCC
        );
        Anchor: (Bottom: 10);
      }

      Group #permissionsList {
        LayoutMode: Top;
        Anchor: (Bottom: 10);

        Group #renameGroup {
          LayoutMode: Right;
          Anchor: (Height: 30);

          CheckBox #RenameCheckbox {
            Anchor: (Width: 20, Height: 20);
          }

          Label #renameLabel {
            Text: "Rename Faction";
            Style: (
              FontSize: 14,
              TextColor: #CCCCCC
            );
            Anchor: (Left: 10);
          }
        }

        Group #colorGroup {
          LayoutMode: Right;
          Anchor: (Height: 30);

          CheckBox #ColorCheckbox {
            Anchor: (Width: 20, Height: 20);
          }

          Label #colorLabel {
            Text: "Change Color";
            Style: (
              FontSize: 14,
              TextColor: #CCCCCC
            );
            Anchor: (Left: 10);
          }
        }

        Group #inviteGroup {
          LayoutMode: Right;
          Anchor: (Height: 30);

          CheckBox #InviteCheckbox {
            Anchor: (Width: 20, Height: 20);
          }

          Label #inviteLabel {
            Text: "Invite Members";
            Style: (
              FontSize: 14,
              TextColor: #CCCCCC
            );
            Anchor: (Left: 10);
          }
        }

        Group #alliesGroup {
          LayoutMode: Right;
          Anchor: (Height: 30);

          CheckBox #AlliesCheckbox {
            Anchor: (Width: 20, Height: 20);
          }

          Label #alliesLabel {
            Text: "Manage Allies";
            Style: (
              FontSize: 14,
              TextColor: #CCCCCC
            );
            Anchor: (Left: 10);
          }
        }

        Group #kickGroup {
          LayoutMode: Right;
          Anchor: (Height: 30);

          CheckBox #KickCheckbox {
            Anchor: (Width: 20, Height: 20);
          }

          Label #kickLabel {
            Text: "Kick Members";
            Style: (
              FontSize: 14,
              TextColor: #CCCCCC
            );
            Anchor: (Left: 10);
          }
        }

        Group #enemiesGroup {
          LayoutMode: Right;
          Anchor: (Height: 30);

          CheckBox #EnemiesCheckbox {
            Anchor: (Width: 20, Height: 20);
          }

          Label #enemiesLabel {
            Text: "Manage Enemies";
            Style: (
              FontSize: 14,
              TextColor: #CCCCCC
            );
            Anchor: (Left: 10);
          }
        }
      }

      Group #spacer {
        FlexWeight: 1;
      }

      Group #ActionButtons {
        LayoutMode: Right;
        Anchor: (Bottom: 10);

        $C.@TextButton #saveButton {
          Text: "Save";
          Padding: (Left: 12, Right: 12, Top: 6, Bottom: 6);
        }

        $C.@CancelTextButton #cancelButton {
          Text: "Cancel";
          Padding: (Left: 12, Right: 12, Top: 6, Bottom: 6);
          Anchor: (Right: 10);
        }
      }
    }
  }
}

$C.@BackButton {}
