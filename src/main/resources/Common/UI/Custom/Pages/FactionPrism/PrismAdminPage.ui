$C = "../../Common.ui";

$C.@PageOverlay {

  $C.@DecoratedContainer {
    Anchor: (Width: 900, Height: 600);

    #Title {
      Group {
        $C.@Title #TitleText {
          @Text = "Prism attacks (admin)";
        }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Left: 20, Right: 20, Top: 20, Bottom: 20);
      FlexWeight: 1;

      Label #noAttacksLabel {
        Text: "No prism attacks";
        Style: (
          FontSize: 16,
          TextColor: #96a9be
        );
        Anchor: (Height: 30);
        Visible: false;
      }

      Group #AttackList {
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        FlexWeight: 1;
      }

      Group { Anchor: (Height: 16); }

      Group #InteractionButtons {
        LayoutMode: Right;
        Anchor: (Height: 44);

        $C.@TextButton #backButton {
          Text: "Back";
          Anchor: (Width: 120, Height: 40);
        }

        Group { Anchor: (Width: 12); }

        $C.@CancelTextButton #closeButton {
          Text: "Close";
          Anchor: (Width: 110, Height: 40);
        }
      }
    }
  }
}
