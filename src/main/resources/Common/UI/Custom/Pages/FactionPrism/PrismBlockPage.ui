$C = "../../Common.ui";

$C.@PageOverlay {

  $C.@DecoratedContainer {
    Anchor: (Width: 400, Height: 200);

    #Title {
      Group {
        $C.@Title #TitleText {
          @Text = "Prism Block";
        }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Left: 20, Right: 20, Top: 20, Bottom: 20);

      Group #TimeAliveGroup {
        Label #TimeAliveText {
          Text: "Time alive: 0 min";
        }
      }

      Group #ActionButtons {
        LayoutMode: Center;
        Anchor: (Bottom: 10);

        $C.@TextButton #HarvestButton {
          Text: "Harvest";
          Padding: (Left: 12, Right: 12, Top: 6, Bottom: 6);
        }

        $C.@TextButton #AttackButton {
          Text: "Attack";
          Padding: (Left: 12, Right: 12, Top: 6, Bottom: 6);
        }
      }
    }
  }
}

$C.@BackButton {}
