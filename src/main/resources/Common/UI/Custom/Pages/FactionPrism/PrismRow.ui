$C = "../../Common.ui";

Group {
  LayoutMode: Right;
  Anchor: (Height: 92);
  Padding: (Left: 12, Right: 12, Top: 8, Bottom: 8);
  Background: #1e2832(0.6);

  Group {
    LayoutMode: Top;
    FlexWeight: 1;
    Anchor: (Vertical: 0);

    Label #PointsLabel {
      Text: "";
      Style: (
        FontSize: 16,
        TextColor: #ffffff
      );
      Anchor: (Height: 22);
    }
    Group { Anchor: (Height: 4); }
    Label #CoordsLabel {
      Text: "";
      Style: (
        FontSize: 14,
        TextColor: #96a9be
      );
      Anchor: (Height: 20);
    }
    Group { Anchor: (Height: 4); }
    Label #MultiplierLabel {
      Text: "";
      Style: (
        FontSize: 14,
        TextColor: #96a9be
      );
      Anchor: (Height: 18);
    }
    Group { Anchor: (Height: 8); }
  }

  Group { Anchor: (Width: 12); }

  $C.@TextButton #DefendButton {
    Text: "Defend";
    Anchor: (Width: 90, Height: 36);
    Visible: false;
  }
}
