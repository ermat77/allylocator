$C = "../../Common.ui";

$C.@PageOverlay {

  $C.@DecoratedContainer {
    Anchor: (Width: 400, Height: 380);

    #Title {
      Group {
        $C.@Title #TitleText {
          @Text = "Your Prism";
        }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Left: 20, Right: 20, Top: 20, Bottom: 20);

      Group #TimeAliveGroup {
        Label #TimeAliveText {
          Text: "Time alive: 0 min";
        }
      }

      Group #EffectMultiplierGroup {
        Label #EffectMultiplierText {
          Text: "Effect multiplier: 1";
        }
      }

      Group #ChangeFactionGroup {
        LayoutMode: Top;
        Anchor: (Height: 140);

        Label #ChangeFactionLabel {
          Text: "Change faction (testing):";
          Anchor: (Height: 24);
          Style: (FontSize: 14, TextColor: #96a9be);
        }

        Group #FactionList {
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Anchor: (Height: 100);
        }
      }

      Group #ActionButtons {
        LayoutMode: Center;
        Anchor: (Bottom: 10);

        $C.@TextButton #HarvestButton {
          Text: "Harvest";
          Padding: (Left: 12, Right: 12, Top: 6, Bottom: 6);
        }

        $C.@TextButton #CancelPrismButton {
          Text: "Cancel Prism";
          Padding: (Left: 12, Right: 12, Top: 6, Bottom: 6);
        }
      }
    }
  }
}

$C.@BackButton {}
