$C = "../Common.ui";
Group {
  Anchor: (Width: 32, Height: 32);
  
  // Button for click events
  TextButton #Button {
    Anchor: (Full: 0);
    Background: (Color: #808080ff);
    Padding: (Left: 12, Right: 6, Top: 6, Bottom: 6);
    TextTooltipShowDelay: 0.1;
    Style: TextButtonStyle(
      Default: (
        LabelStyle: (
          FontSize: 14,
          TextColor: #ffffffff
        )
      ),
      Sounds: $C.@ButtonSounds
    );
  }
}
